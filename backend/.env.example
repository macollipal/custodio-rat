# Configuracion de ambiente - COPIAR a .env y completar valores
# NUNCA commitear este archivo con valores reales al repositorio

# ─── LEY DIVINA DE SEGURIDAD ─────────────────────────────────────
# 1. Todas las credenciales van en .env (que esta en .gitignore)
# 2. NO hacer fallback con passwords hardcodeadas en codigo
# 3. Usar variables de entorno para todo secreto: API keys, passwords, tokens
# 4. Los archivos .env NUNCA se commitean
# 5. Si una credencial se expone, ROTARLA inmediatamente
# ──────────────────────────────────────────────────────────────────

# ─── Base de datos DEV ────────────────────────────────────────────
# Desarrollo (Postgres Neon) - usa branch "dev" separado de QA
# IMPORTANTE: este password debe ser DIFERENTE al de QA y Test
# Obtenerlo de Neon Console > Branches > dev > Connection Details
# DATABASE_URL=postgresql://neondb_owner:<PASSWORD_DEV>@<HOST_DEV>/<DB_DEV>?sslmode=require&channel_binding=require

# ─── Base de datos QA ─────────────────────────────────────────────
# QA (Postgres Neon) - branch principal usado por Vercel QA
# Obtenerlo de Vercel Dashboard > custodio-qa > Environment Variables > DATABASE_URL
DATABASE_URL=postgresql://neondb_owner:<PASSWORD_QA>@<HOST_QA>/<DB_QA>?sslmode=require&channel_binding=require

# ─── Base de datos TEST (para pytest) ────────────────────────────
# Database "custodio_test" usada SOLO por pytest
# IMPORTANTE: rotar este password independientemente del de QA
# Si falla el login, rotar en Neon Console y actualizar aqui
TEST_DATABASE_URL=postgresql://neondb_owner:<PASSWORD_TEST>@<HOST_TEST>/<DB_TEST>?sslmode=require

# Ambiente: development | qa | production
ENVIRONMENT=development

# ─── CORS ─────────────────────────────────────────────────────────
# Lista blanca separada por comas (sin espacios)
# Local dev:   http://localhost:3000 (Next.js)
# QA:          https://custodio-qa.vercel.app,http://localhost:3000
# Produccion:  https://custodio-rat.vercel.app
ALLOWED_ORIGINS=http://localhost:3000

# ─── Seguridad JWT ─────────────────────────────────────────────────
# Generar con: openssl rand -hex 64
SECRET_KEY=<TU_SECRET_KEY_JWT_64_HEX>

# ─── SMTP (SendGrid u otro proveedor) ────────────────────────────
# Obtener API key de SendGrid Dashboard > Settings > API Keys
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USERNAME=apikey
SMTP_PASSWORD=<TU_SENDGRID_API_KEY>
SMTP_FROM_EMAIL=admin@yopmail.com
SMTP_FROM_NAME=Custodio RAT Manager
SMTP_USE_TLS=true

# ─── OCI Object Storage (produccion) ─────────────────────────────
# Para desarrollo local, comentar OCI_CONFIG y OCI_KEY_CONTENT (usa BYTEA en BD)
# OCI_CONFIG={"backend":"oci","namespace":"<NAMESPACE>","region":"<REGION>","bucket":"<BUCKET>","tenancy":"<TENANCY_OCID>","user":"<USER_OCID>","fingerprint":"<FINGERPRINT>"}
# OCI_KEY_CONTENT="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# ─── ENCRYPTION_KEY (Fernet para PII) ────────────────────────────
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=<TU_FERNET_KEY>

# ─── Asesor IA ────────────────────────────────────────────────────
# LLM chat (Groq): https://console.groq.com → API Keys
# GROQ_API_KEY=gsk_...
# Embeddings (Cohere): https://dashboard.cohere.com → API Keys
# COHERE_API_KEY=...

# ─── Admin inicial (solo para primer deploy) ─────────────────────
# SEED_ADMIN=true
# SEED_ADMIN_PASSWORD=<TU_PASSWORD_ADMIN_INICIAL>