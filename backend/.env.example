# Configuración de ambiente - COPIAR a .env y completar valores
# NUNCA commitear este archivo con valores reales al repositorio

# =============================================================================
# LEY DIVINA DE SEGURIDAD: No exponer credenciales en el repositorio
# =============================================================================
# 1. Todas las credenciales van en .env (que está en .gitignore)
# 2. NO hacer fallback con passwords hardcodeadas en código
# 3. Usar变量 de entorno para todo secreto: API keys, passwords, tokens
# 4. Los archivos .env NUNCA se commitear
# 5. Si una credencial se expone, ROTARLA inmediatamente
# =============================================================================

# Base de datos de test (PostgreSQL)
# Obtener URL de Neon Dashboard -> Connection Details -> Connection string
TEST_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Backend API (desarrollo local)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
SECRET_KEY=generar_con_openssl_rand_-hex_64

# API Keys (solo producción/QA real)
# MINIMAX_API_KEY=sk-xxxx
# OPENAI_API_KEY=sk-xxxx
# SMTP_URL=smtplib://apikey:SG.xxx@smtp.sendgrid.net:587/?use_tls=true
