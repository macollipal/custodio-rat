# ─── Asesor RAG (Dual Provider) ───────────────────────────────────
# Embeddings: Cohere (COHERE_API_KEY) — free tier, sin rate limit
# Chat: Groq (GROQ_API_KEY) — free tier, sin rate limit
COHERE_API_KEY=tu_api_key_de_cohere
GROQ_API_KEY=tu_api_key_de_grok_gsk-aqui
GROQ_CHAT_MODEL=llama-3.3-70b-versatile

# MINIMAX ya no se usa para embeddings ni chat
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M2.7

# Config del Asesor en JSON (opcional — si esta vacio usa los defaults de abajo)
# Si defines ASESOR_CONFIG, estos valores se ignoran:
ASESOR_CONFIG={"chunk_size":800,"chunk_overlap":100,"top_k":5,"min_similarity":0.3,"llm_max_tokens":1000,"llm_temperature":0.3,"corpus_path":"data/asesor_corpus","embedding_model":"embed-multilingual-v3.0"}

# Defaults individuales (usados si ASESOR_CONFIG esta vacio):
ASESOR_CHUNK_SIZE=800
ASESOR_CHUNK_OVERLAP=100
ASESOR_TOP_K=5
ASESOR_MIN_SIMILARITY=0.5
ASESOR_LLM_MAX_TOKENS=1000
ASESOR_LLM_TEMPERATURE=0.3
ASESOR_CORPUS_PATH=data/asesor_corpus

# ─── JWT ──────────────────────────────────────────────────────────
# En Linux/Mac: openssl rand -hex 64
# En Windows PowerShell: $bytes = New-Object byte[] 32; (New-Object System.Security.Cryptography.RandomNumberGenerator).GetBytes($bytes); [BitConverter]::ToString($bytes) -replace '-', ''
SECRET_KEY=cambia-esta-clave-en-produccion-por-una-de-256-bits

# Encryption Key (Fernet) — OBLIGATORIO en produccion para cifrar datos en reposo
# Generar clave: cd backend && python -c "from app.core.crypto import generate_key; print(generate_key())"
ENCRYPTION_KEY=

# ─── Ambiente ─────────────────────────────────────────────────────
ENVIRONMENT=development

# Dominios permitidos para CORS (OBLIGATORIO en todos los ambientes)
# Formato: origen1,origen2,origen3 (sin espacios)
# QA:     ALLOWED_ORIGINS=https://custodio-qa.vercel.app,http://localhost:3000
# Prod:   ALLOWED_ORIGINS=https://custodio-rat.vercel.app
ALLOWED_ORIGINS=

# ─── Base de datos ────────────────────────────────────────────────
# Desarrollo (SQLite local):
#   DATABASE_URL=sqlite:///database.db
#
# Produccion (Neon PostgreSQL):
#   DATABASE_URL=postgresql://user:password@ep-xxx-xxx-123456.neon.tech/custodio?sslmode=require
#
# Para obtener la URL de Neon:
#   1. Ve a console.neon.tech → tu proyecto → Connection Details
#   2. Copia la URL completa (reemplaza <password> con tu contrasena)
DATABASE_URL=sqlite:///database.db
